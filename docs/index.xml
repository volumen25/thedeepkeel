  <title>Happy Birthday Servet Abla</title>
  <link>https://guitars.volumen.ca/posts/2026-06-17/</link>
  <description><![CDATA[ 




<section id="video" class="level2">
<h2 class="anchored" data-anchor-id="video">Video</h2>
<div class="quarto-video ratio ratio-16x9"><iframe data-external="1" src="https://www.youtube.com/embed/DzTANX68oL0" title="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen=""></iframe></div>
</section>
<section id="fender-telecaster" class="level2">
<h2 class="anchored" data-anchor-id="fender-telecaster">Fender Telecaster</h2>
<p>Pickup Position: Neck<br>
Master Volume: ~5<br>
Master Tone: ~6</p>
</section>
<section id="zoom-g3xn" class="level2">
<h2 class="anchored" data-anchor-id="zoom-g3xn">Zoom G3Xn</h2>
<p>150 Trem Etc</p>
</section>
