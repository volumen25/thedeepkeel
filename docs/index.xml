  <link>https://guitars.volumen.ca/posts/2026-04-19/</link>
  <description><![CDATA[ 




<section id="tablature-were-going-to-be-friends" class="level2">
<h2 class="anchored" data-anchor-id="tablature-were-going-to-be-friends">Tablature: We’re Going To Be Friends</h2>
<p><a href="tab.pdf">Download</a></p>
</section>
<section id="tempo-90-bpm" class="level2">
<h2 class="anchored" data-anchor-id="tempo-90-bpm">Tempo: 90 bpm</h2>
<audio controls="">
<source src="WereGoingToBeFriends90.m4a" type="audio/mpeg">
</audio>
</section>
<section id="audio-60-bpm" class="level2">
<h2 class="anchored" data-anchor-id="audio-60-bpm">Audio: 60 bpm</h2>
<audio controls="">
<source src="Friends2026-05-10.mp3" type="audio/mpeg">
</audio>
</section>
<section id="tempo-60-bpm" class="level2">
<h2 class="anchored" data-anchor-id="tempo-60-bpm">Tempo: 60 bpm</h2>
<audio controls="">
<source src="WereGoingToBeFriends.m4a" type="audio/mpeg">
</audio>
</section>
<section id="video" class="level2">
<h2 class="anchored" data-anchor-id="video">Video</h2>
<p>Video Tempo: 90%</p>
<div class="quarto-video ratio ratio-16x9"><iframe data-external="1" src="https://www.youtube.com/embed/WD8IF7F4Pqo" title="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen=""></iframe></div>
